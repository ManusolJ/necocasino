{
  "name": "casino",
  "version": "0.0.0",
  "scripts": {
    "lint": "ng lint",
    "test": "ng test",
    "build": "ng build",
    "start": "ng serve",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-interface": "ng generate interface --path=src/app/shared/models",
    "create-feature": "ng generate component --skip-tests true --path=src/app/features",
    "create-service": "ng generate service --skip-tests true --path=src/app/core/services",
    "create-component": "ng generate component --skip-tests true --path=src/app/shared/components",
    "create-pipe": "ng generate pipe --skip-tests true --path=src/app/shared/pipes",
    "create-guard": "ng generate guard --skip-tests true --implements CanActivate --path=src/app/core/guards"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/cli": "^22.2.3",
    "@angular/build": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "tailwindcss": "^4.1.12",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8",
    "wrangler": "^4.15.2",
    "eslint": "^10.10.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.6.0",
    "typescript-eslint": "^8.69.0",
    "eslint-plugin-perfectionist": "^5.11.0"
  }
}
